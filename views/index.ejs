<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Express + Sequelize Form</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background: #f4f6fb;
      }
      .container {
        display: flex;
        min-height: 100vh;
      }
      .form-panel {
        flex: 0 0 30%;
        padding: 24px;
        background: #fff;
        box-shadow: 2px 0 12px rgba(0, 0, 0, 0.04);
      }
      .data-panel {
        flex: 1;
        padding: 24px;
      }
      h1,
      h2 {
        margin-top: 0;
      }
      label {
        display: block;
        margin: 16px 0 8px;
        font-weight: 600;
      }
      input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #d7dce8;
        border-radius: 6px;
        box-sizing: border-box;
      }
      button {
        margin-top: 20px;
        padding: 12px 18px;
        border: none;
        border-radius: 6px;
        background: #3b82f6;
        color: white;
        cursor: pointer;
        font-size: 16px;
      }
      button:hover {
        background: #2563eb;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
      }
      th,
      td {
        padding: 14px 16px;
        border-bottom: 1px solid #e5e7eb;
        text-align: left;
      }
      th {
        background: #f3f4f6;
      }
      .empty-state {
        padding: 24px;
        background: #fff;
        border-radius: 12px;
        color: #555;
      }
      .message {
        margin-top: 12px;
        color: #065f46;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="form-panel">
        <h1>New User</h1>
        <form action="/users" method="POST">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />

          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />

          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="text" required />

          <button type="submit">Save</button>
        </form>
        <% if (message) { %>
        <p class="message"><%= message %></p>
        <% } %>
      </div>

      <div class="data-panel">
        <h2>Saved Users</h2>
        <% if (users.length === 0) { %>
        <div class="empty-state">No users found yet. Submit the form to add one.</div>
        <% } else { %>
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((user, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td><%= user.phone %></td>
              <td><%= user.createdAt.toISOString().slice(0, 19).replace("T", " ") %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </div>
    </div>
  </body>
</html>
